{
  "name": "wortflip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Deutsch-Wortschatz (A1–A2) mit wischbaren Karteikarten lernen – offline, ohne Anmeldung.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "import": "node scripts/import-vocabulary.mjs",
    "import:translations": "node scripts/import-translations.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "author": "Mohamed Akram Lamhour",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lamhour-Mohamed-Akram/Wortflip.git"
  },
  "homepage": "https://wortflip.de"
}
